# Optional: override the Japanese font used for text compositing
FONT_PATH=fonts/NotoSansJP-Bold.otf

# Optional: daily run time (24h, local server time) and reply-check interval
DAILY_POST_HOUR=8
DAILY_POST_MINUTE=0
REPLY_CHECK_INTERVAL_MINUTES=5

# Set to false to skip auto-posting to X and instead log the generated image/text
# for manual posting. After posting manually, run:
#   python3 register_tweet_id.py <tweet_id>
# so the reply auto-responder knows which tweet to watch.
AUTO_POST_TO_X=true
