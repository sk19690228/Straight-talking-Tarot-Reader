# OpenAI
OPENAI_API_KEY=

# X (Twitter) - https://developer.twitter.com
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Instagram Graph API - https://developers.facebook.com/docs/instagram-api
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Threads API - https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Publicly reachable base URL used to serve generated images to Instagram/Threads
# (both APIs require an https image URL, not a local file upload).
PUBLIC_IMAGE_BASE_URL=

# Optional: override the Japanese font used for text compositing
FONT_PATH=fonts/NotoSansJP-Bold.otf

# Optional: daily run time (24h, local server time) and reply-check interval
DAILY_POST_HOUR=8
DAILY_POST_MINUTE=0
REPLY_CHECK_INTERVAL_MINUTES=5
